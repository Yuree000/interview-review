APP_ENV=development
APP_DEBUG=true

OUTPUT_DIR=./outputs
AUDIO_OUTPUT_DIR=./audio_cache
LOG_DIR=./logs
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe

TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
ASR_REGION=ap-guangzhou
ASR_ENGINE_MODEL=16k_zh
ASR_MAX_RETRIES=3
ASR_POLL_INTERVAL_SECONDS=5
ASR_TIMEOUT_SECONDS=1800

COS_REGION=ap-guangzhou
COS_BUCKET=
COS_PREFIX=asr-input/
COS_URL_EXPIRE_SECONDS=3600

LLM_API_KEY=
LLM_BASE_URL=https://api.moonshot.cn/v1
LLM_MODEL=kimi-k2.5
LLM_STRUCTURED_MODEL=moonshot-v1-128k
